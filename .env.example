# ---------------------------------------------------------------------------
# Nirikshan - example environment file.
# Copy to `.env` and adjust. NEVER commit a real `.env`.
# The platform runs fully without the optional AI keys (mock provider is used).
# ---------------------------------------------------------------------------

# --- Core ---
NIRIKSHAN_ENV=development
NIRIKSHAN_LOG_LEVEL=INFO
# Comma-separated origins allowed by CORS for the API.
NIRIKSHAN_CORS_ORIGINS=http://localhost:3000

# --- Security ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
NIRIKSHAN_SECRET_KEY=dev-only-insecure-secret-change-me
NIRIKSHAN_ACCESS_TOKEN_TTL_MINUTES=60
NIRIKSHAN_REFRESH_TOKEN_TTL_MINUTES=43200
# Seed an initial admin on first boot (dev convenience only).
NIRIKSHAN_BOOTSTRAP_ADMIN_EMAIL=admin@nirikshan.dev
NIRIKSHAN_BOOTSTRAP_ADMIN_PASSWORD=admin12345
# Optional: require X-Ingest-Token on /api/telemetry/* (unset = open, demo only)
NIRIKSHAN_INGEST_TOKEN=

# --- Database (PostgreSQL is authoritative) ---
# Docker Compose provides this value automatically for the api/worker services.
NIRIKSHAN_DATABASE_URL=postgresql+psycopg://nirikshan:nirikshan@localhost:5432/nirikshan
# For isolated local unit tests only:
# NIRIKSHAN_DATABASE_URL=sqlite+pysqlite:///./nirikshan.sqlite3

# --- Redis (events, cache, rate limiting) ---
NIRIKSHAN_REDIS_URL=redis://localhost:6379/0
NIRIKSHAN_REDIS_STREAM_MAXLEN=50000

# --- Telemetry retention (demo-safe defaults) ---
NIRIKSHAN_RETENTION_LOGS_HOURS=72
NIRIKSHAN_RETENTION_METRICS_HOURS=168
NIRIKSHAN_RETENTION_TRACES_HOURS=72

# --- Rate limits (requests / window seconds) ---
NIRIKSHAN_RATELIMIT_TELEMETRY=2000/60
NIRIKSHAN_RATELIMIT_INVESTIGATE=10/60
NIRIKSHAN_RATELIMIT_REMEDIATION=20/60
NIRIKSHAN_RATELIMIT_DEFAULT=300/60

# --- AI provider abstraction ---
# provider: mock | openai | groq
NIRIKSHAN_LLM_PROVIDER=mock
NIRIKSHAN_LLM_MODEL=mock-sre-1
NIRIKSHAN_LLM_TIMEOUT_SECONDS=45
NIRIKSHAN_LLM_MAX_TOOL_ITERATIONS=8
# Only needed when provider is openai/groq. Leave blank to force mock.
NIRIKSHAN_LLM_API_KEY=
NIRIKSHAN_LLM_BASE_URL=

# embedding provider: local | openai
NIRIKSHAN_EMBEDDING_PROVIDER=local
NIRIKSHAN_EMBEDDING_MODEL=local-hash-256
NIRIKSHAN_EMBEDDING_DIM=256

# --- Remediation ---
# OBSERVE | RECOMMEND | APPROVAL_REQUIRED | AUTONOMOUS  (default is safe)
NIRIKSHAN_REMEDIATION_MODE=APPROVAL_REQUIRED

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
